# Copy to .env.web, chmod 600. Never put host SSH/sudo credentials here.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=<choose-a-unique-password-at-least-12-characters>
SRS_MODE=demo
# Demo uses isolated local SQLite. Real modes require migrated MariaDB.
# SRS_DATABASE_URL=mysql+pymysql://srs_web:<url-encoded-db-password>@127.0.0.1:3306/srs?charset=utf8mb4
# SRS_COOKIE_SECURE=true
# SRS_ALLOWED_ORIGINS=https://your-private-control-host
# SRS_SLURM_BASE_URL=http://127.0.0.1:6820
# SRS_SLURM_OWNER=srs-runner
# SRS_SLURM_CONTROLLER_ID=controller-node
