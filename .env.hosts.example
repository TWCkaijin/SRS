# Executor only; copy to .env.hosts and chmod 600. Parsed as data, never shell source.
HOST_AI_LAB_225_USERNAME=admin
HOST_AI_LAB_225_SSH_PASSWORD=<225-ssh-password>
HOST_AI_LAB_225_SUDO_PASSWORD=<225-sudo-password>
HOST_AI_LAB_250_USERNAME=admin
HOST_AI_LAB_250_SSH_PASSWORD=<250-ssh-password>
HOST_AI_LAB_250_SUDO_PASSWORD=<250-sudo-password>
# Must belong to the non-root Slurm job owner named in the approved plan.
SLURM_USERNAME=srs-runner
SLURM_TOKEN=<short-lived-owner-jwt>