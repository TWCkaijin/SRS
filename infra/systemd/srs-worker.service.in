[Unit]
Description=Server Remote System approved-plan worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=srs-executor
Group=srs
WorkingDirectory=/opt/server-remote-system
EnvironmentFile=/etc/server-remote-system/executor.env
ExecStart=/opt/server-remote-system/.venv/bin/python -m srs.cli worker --credentials-file /etc/server-remote-system/hosts.env
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/server-remote-system /var/log/server-remote-system

[Install]
WantedBy=multi-user.target
